{
  "expo": {
    "name": "ครูติว AI",
    "slug": "krutew-ai",
    "scheme": "krutewai",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.tatsana.pn.krutiwai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7F2"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4,
      "package": "com.miaoda.krutewai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client",
      "expo-image",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can photograph your homework.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can upload a homework picture."
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93504d6d-6f32-4b8d-95a7-ec4925c6a3c7"
      }
    },
    "owner": "tatsana.pn"
  }
}
